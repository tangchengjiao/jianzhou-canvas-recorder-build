{
  "name": "excalidraw-recorder",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:content": "node scripts/content-smoke.mjs",
    "smoke:markdown": "node scripts/markdown-smoke.mjs",
    "smoke:html": "node scripts/safe-html-smoke.mjs",
    "smoke:sink": "node scripts/recording-sink-smoke.mjs",
    "smoke:media": "node scripts/media-smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "native:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-native-prerequisites.ps1",
    "desktop:info": "tauri info",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:dev": "tauri dev",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:build": "tauri build --bundles nsis --no-sign --ci",
    "desktop:package": "node scripts/package-desktop-beta.mjs",
    "desktop:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg --config src-tauri/tauri.macos.conf.json --ci",
    "desktop:package:mac": "node scripts/package-macos-beta.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "node scripts/copy-excalidraw-assets.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "pdfjs-dist": "6.1.200",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.1.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "playwright-core": "1.61.1",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
